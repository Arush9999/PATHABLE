# PathAble environment configuration template
# Copy this file to .env and fill in values for production services.
# Never commit real credentials or service-role keys.

# App mode: demo | production
PATHABLE_MODE=demo

# Supabase (required for real accounts, reports, and sync)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Sign-In (OAuth 2.0 Web client ID — used as serverClientId)
# Create in Google Cloud Console; enable Google provider in Supabase Auth.
GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client ID (required on iOS / macOS)
GOOGLE_IOS_CLIENT_ID=

# MapLibre-compatible style URL (must end with style.json for MapLibre)
# MapTiler example:
# MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v4/style.json?key=YOUR_KEY
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Optional MapTiler key (used for geocoding when GEOCODING_URL is MapTiler)
MAPTILER_API_KEY=

# Valhalla routing endpoint (path/trail/sidewalk routing — required for live directions)
# Local Docker example after scripts/valhalla setup:
# VALHALLA_URL=http://127.0.0.1:8002
# Android emulator → host machine:
# VALHALLA_URL=http://10.0.2.2:8002
VALHALLA_URL=

# Optional geocoding endpoint (leave empty to use demonstration geocoding)
# MapTiler: https://api.maptiler.com/geocoding
GEOCODING_URL=
