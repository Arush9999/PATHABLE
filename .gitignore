# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Secrets — never commit real credentials
.env
.env.local
.env.*.local
!.env.example
assets/config/.env
